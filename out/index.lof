\contentsline {figure}{\numberline {1.1}{\ignorespaces Rappresentazione geometrica di un qubit sulla sfera di Bloch. I poli nord e sud corrispondono agli stati base $\ket {0}$ e $\ket {1}$.}}{2}{figure.1.1}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Schema del centro NV nel reticolo cristallino del diamante. L'atomo di azoto sostituisce un carbonio e la lacuna occupa il sito adiacente lungo l'asse $\langle 111 \rangle $.}}{13}{figure.2.1}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Struttura dei livelli energetici del centro NV$^-$. La transizione ottica a 637\,nm (ZPL, \textit {zero-phonon line}) eccita il tripletto; il \textit {inter-system crossing} (ISC) verso il singoletto $^1A_1$ pompa preferenzialmente la popolazione in $m_s = 0$, abilitando l'inizializzazione ottica del qubit.}}{14}{figure.2.2}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Ricercatori del Dipartimento di Fisica \textit {Ettore Pancini} al lavoro sul criostato di Partenope durante l'installazione del nuovo processore a 64 qubit (2026). Fonte: ICSC.}}{22}{figure.3.1}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces I rack di Qolossus 2.0 alla Sapienza, con i moduli fotonici etichettati \textit {Qolossus 2.0}, \textit {CNR-IFN} e \textit {Demultiplexer}. Fonte: Sapienza Università di Roma / ICSC.}}{23}{figure.3.2}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Il banco ottico della piattaforma ad atomi neutri del CNR a Sesto Fiorentino, con la camera a vuoto, le ottiche e i fasci laser. Fonte: ICSC / CNR.}}{24}{figure.3.3}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces L'edificio del Quantum Computing Lab dell'Università di Padova il giorno dell'inaugurazione (2 marzo 2026). Fonte: Università di Padova.}}{25}{figure.3.4}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Il computer quantistico IQM a 5 qubit nel data center del Politecnico di Torino: al centro il criostato (il cilindro bianco), a sinistra il pannello del sistema di raffreddamento e a destra il rack dell'elettronica di controllo. Fonte: Politecnico di Torino.}}{27}{figure.3.5}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Schema dell'algoritmo di Grover su tre qubit. Il blocco oracolo + diffusione viene ripetuto circa $\frac {\pi }{4}\sqrt {N}$ volte prima della misura.}}{32}{figure.4.1}%
